import random\
import re\
\
text = """\
Cybersecurity is important for protecting data.\
Cybersecurity helps prevent cyber attacks.\
Data protection is essential.\
"""\
\
# Preprocess text\
text = text.lower()\
text = re.sub(r'[^\\w\\s]', '', text)\
words = text.split()\
\
markov_chain = \{\}\
\
for i in range(len(words) - 1):\
    word = words[i]\
    next_word = words[i + 1]\
\
    if word not in markov_chain:\
        markov_chain[word] = []\
\
    markov_chain[word].append(next_word)\
\
def generate_text(chain, start_word, length=20):\
    current_word = start_word\
    result = [current_word]\
    for _ in range(length - 1):\
        next_words = chain.get(current_word)\
        if not next_words:\
            break\
        current_word = random.choice(next_words)\
        result.append(current_word)\
    return " ".join(result)\
\
print(generate_text(markov_chain, "cybersecurity"))\
}